{
  "expo": {
    "name": "Atlas",
    "slug": "atlas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lucaszirpoli.atlas",
      "infoPlist": {
        "NSCameraUsageDescription": "O Atlas usa a câmera para escanear o código de barras de alimentos e para tirar fotos de refeições e de progresso.",
        "NSPhotoLibraryUsageDescription": "O Atlas acessa suas fotos para você escolher uma foto de refeição, de progresso ou de perfil.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "package": "com.lucaszirpoli.atlas",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#081020",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 57
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#081020"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Atlas usa sua localização só quando você faz check-in na academia, para provar sua presença nos desafios com amigos.",
          "locationWhenInUsePermission": "O Atlas usa sua localização só quando você faz check-in na academia, para provar sua presença nos desafios com amigos.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "./plugins/withCleartextTraffic",
      "./plugins/withOptionalHardwareFeatures",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.608725750172-1r6d7vra618jdbpft54s4mosf2bngd56"
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "82c06880-b60c-4904-aae7-d3a2e2b579ee"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/82c06880-b60c-4904-aae7-d3a2e2b579ee"
    }
  }
}
